#!/usr/bin/env bash
set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
pi_agent_dir=${PI_AGENT_DIR:-"$HOME/.pi/agent"}
workspace_root=${PI_WORKSPACE_ROOT:-"$HOME/Developer"}
pi_bin_dir=${PI_BIN_DIR:-"$HOME/.local/bin"}

while IFS= read -r skill_name; do
  [ -n "$skill_name" ] || continue
  case $skill_name in
    *[!a-z0-9-]*)
      printf 'error: invalid skill name in catalog: %s\n' "$skill_name" >&2
      exit 1
      ;;
  esac
  if [ ! -f "$repo_root/skills/$skill_name/SKILL.md" ]; then
    printf 'error: catalogued skill is missing SKILL.md: %s\n' "$skill_name" >&2
    exit 1
  fi
done < "$repo_root/skills/catalog.txt"

link_path() {
  source_path=$1
  target_path=$2

  if [ -L "$target_path" ]; then
    current=$(readlink "$target_path")
    if [ "$current" = "$source_path" ]; then
      printf 'ok %s\n' "$target_path"
      return
    fi
    printf 'error: %s points to %s, expected %s\n' "$target_path" "$current" "$source_path" >&2
    return 1
  fi

  if [ -e "$target_path" ]; then
    printf 'error: refusing to overwrite existing path: %s\n' "$target_path" >&2
    return 1
  fi

  mkdir -p "$(dirname -- "$target_path")"
  ln -s "$source_path" "$target_path"
  printf 'linked %s -> %s\n' "$target_path" "$source_path"
}

link_path "$repo_root/config/AGENTS.md" "$pi_agent_dir/AGENTS.md"
link_path "$repo_root/config/Developer.AGENTS.md" "$workspace_root/AGENTS.md"
link_path "$repo_root/extensions/tool-profiles.ts" "$pi_agent_dir/extensions/tool-profiles.ts"
link_path "$repo_root/config/skills.README.md" "$pi_agent_dir/skills/README.md"
link_path "$repo_root/bin/pi-task" "$pi_bin_dir/pi-task"

while IFS= read -r skill_name; do
  [ -n "$skill_name" ] || continue
  skill_source="$repo_root/skills/$skill_name"
  if [ ! -f "$skill_source/SKILL.md" ]; then
    printf 'error: catalogued skill is missing SKILL.md: %s\n' "$skill_name" >&2
    exit 1
  fi
  link_path "$skill_source" "$pi_agent_dir/skills/$skill_name"
done < "$repo_root/skills/catalog.txt"

printf 'Pi configuration links restored. pi-task is linked at %s/pi-task. Restart Pi or run /reload.\n' "$pi_bin_dir"
