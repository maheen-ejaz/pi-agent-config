#!/usr/bin/env bash
set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
pi_agent_dir=${PI_AGENT_DIR:-"$HOME/.pi/agent"}
workspace_root=${PI_WORKSPACE_ROOT:-"$HOME/Developer"}
pi_bin_dir=${PI_BIN_DIR:-"$HOME/.local/bin"}
failures=0
check_installed_links=true

case ${1:-} in
  "") ;;
  --source-only) check_installed_links=false ;;
  *) printf 'usage: %s [--source-only]\n' "$0" >&2; exit 2 ;;
esac

check_link() {
  source_path=$1
  target_path=$2

  if [ ! -L "$target_path" ]; then
    printf 'error: expected symlink: %s\n' "$target_path" >&2
    failures=$((failures + 1))
    return
  fi
  current=$(readlink "$target_path")
  if [ "$current" != "$source_path" ]; then
    printf 'error: %s points to %s, expected %s\n' "$target_path" "$current" "$source_path" >&2
    failures=$((failures + 1))
    return
  fi
  printf 'ok %s\n' "$target_path"
}

if $check_installed_links; then
  check_link "$repo_root/config/AGENTS.md" "$pi_agent_dir/AGENTS.md"
  check_link "$repo_root/config/Developer.AGENTS.md" "$workspace_root/AGENTS.md"
  check_link "$repo_root/extensions/tool-profiles.ts" "$pi_agent_dir/extensions/tool-profiles.ts"
  check_link "$repo_root/config/skills.README.md" "$pi_agent_dir/skills/README.md"
  check_link "$repo_root/bin/pi-task" "$pi_bin_dir/pi-task"
fi

manifest_tmp=$(mktemp -d "${TMPDIR:-/tmp}/pi-config-check.XXXXXX")
trap 'rm -rf "$manifest_tmp"' EXIT
: > "$manifest_tmp/catalog"
: > "$manifest_tmp/actual"
: > "$manifest_tmp/readme"

catalog_count=0
while IFS= read -r skill_name; do
  [ -n "$skill_name" ] || continue
  case $skill_name in
    *[!a-z0-9-]*)
      printf 'error: invalid skill name in catalog: %s\n' "$skill_name" >&2
      failures=$((failures + 1))
      continue
      ;;
  esac
  catalog_count=$((catalog_count + 1))
  printf '%s\n' "$skill_name" >> "$manifest_tmp/catalog"
  skill_source="$repo_root/skills/$skill_name"
  if [ ! -f "$skill_source/SKILL.md" ]; then
    printf 'error: catalogued skill is missing SKILL.md: %s\n' "$skill_name" >&2
    failures=$((failures + 1))
    continue
  fi
  if ! git -C "$repo_root" ls-files --error-unmatch -- "skills/$skill_name/SKILL.md" >/dev/null 2>&1; then
    printf 'error: catalogued skill is not tracked by Git: %s\n' "$skill_name" >&2
    failures=$((failures + 1))
  fi
  if $check_installed_links; then
    check_link "$skill_source" "$pi_agent_dir/skills/$skill_name"
  fi
done < "$repo_root/skills/catalog.txt"

for skill_file in "$repo_root"/skills/*/SKILL.md; do
  [ -f "$skill_file" ] || continue
  skill_dir=${skill_file%/SKILL.md}
  printf '%s\n' "${skill_dir##*/}" >> "$manifest_tmp/actual"
done
LC_ALL=C sort -o "$manifest_tmp/catalog" "$manifest_tmp/catalog"
LC_ALL=C sort -o "$manifest_tmp/actual" "$manifest_tmp/actual"
if [ -f "$repo_root/skills/README.md" ]; then
  awk -F'|' '$2 ~ /`[a-z0-9-]+`/ { name=$2; gsub(/[ `]/, "", name); print name }' \
    "$repo_root/skills/README.md" > "$manifest_tmp/readme"
else
  printf 'error: missing skills/README.md catalog summary\n' >&2
  failures=$((failures + 1))
fi
LC_ALL=C sort -o "$manifest_tmp/readme" "$manifest_tmp/readme"
if ! cmp -s "$manifest_tmp/catalog" "$manifest_tmp/actual" || \
   ! cmp -s "$manifest_tmp/catalog" "$manifest_tmp/readme"; then
  printf 'error: catalog, skills README, and skill directories must list each skill exactly once\n' >&2
  failures=$((failures + 1))
fi

# The subagent package writes runtime transcripts under .pi-subagents/. Ignore that
# untracked directory during source scans, but reject anything staged or tracked there.
if [ -n "$(git -C "$repo_root" ls-files --cached -- .pi-subagents)" ]; then
  printf 'error: subagent runtime artifacts must not be tracked by Git\n' >&2
  failures=$((failures + 1))
fi
if find "$repo_root" \( -path "$repo_root/.git" -o -path "$repo_root/.pi-subagents" \) -prune -o -type f \( -name 'auth.json' -o -name 'settings.json' -o -name 'mcp.json' -o -name 'models*.json' -o -name '*.jsonl' -o -name '.env' -o -name '.env.*' \) -print -quit | grep -q .; then
  printf 'error: repository contains a forbidden machine or credential file\n' >&2
  failures=$((failures + 1))
fi
if [ ! -x "$repo_root/bin/pi-task" ]; then
  printf 'error: expected executable task launcher: %s\n' "$repo_root/bin/pi-task" >&2
  failures=$((failures + 1))
fi
if ! git -C "$repo_root" ls-files --error-unmatch -- bin/pi-task >/dev/null 2>&1; then
  printf 'error: task launcher is not tracked by Git: %s\n' "$repo_root/bin/pi-task" >&2
  failures=$((failures + 1))
fi

if find "$repo_root/skills" -type f -path '*/agents/openai.yaml' -print -quit | grep -q .; then
  printf 'error: Pi skills must not include OpenAI-agent metadata files\n' >&2
  failures=$((failures + 1))
fi

secret_pattern='(gho''_|github_pat''_|sk-[A-Za-z0-9_-]{16,}|INFISICAL_''TOKEN|BEGIN (RSA |OPENSSH )?PRIVATE KEY)'
# Print at most one match: grep -q downstream of a many-match producer can
# SIGPIPE that producer under pipefail and incorrectly turn a finding into pass.
if find "$repo_root" \( -path "$repo_root/.git" -o -path "$repo_root/.pi-subagents" \) -prune -o -type f -exec grep -qE "$secret_pattern" {} \; -print -quit | grep -q .; then
  printf 'error: repository contains a secret-like value\n' >&2
  failures=$((failures + 1))
fi

if [ "$failures" -ne 0 ]; then
  printf 'Pi configuration check failed: %s problem(s).\n' "$failures" >&2
  exit 1
fi

printf 'Pi configuration check passed (%s skills).\n' "$catalog_count"
